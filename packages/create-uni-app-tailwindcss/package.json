{
  "name": "create-uni-app-tailwindcss",
  "version": "0.1.0",
  "description": "Create a uni-app project with Vite, Vue 3, Tailwind CSS, and weapp-tailwindcss.",
  "private": false,
  "type": "module",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://github.com/sonofmagic/uni-app-tailwindcss-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/uni-app-tailwindcss-template.git",
    "directory": "packages/create-uni-app-tailwindcss"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/uni-app-tailwindcss-template/issues"
  },
  "keywords": [
