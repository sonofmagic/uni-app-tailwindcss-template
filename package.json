{
  "name": "uni-app-tailwindcss-template",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/uni-app-tailwindcss-template.git"
  },
  "homepage": "https://uniapp.icebreaker.top",
  "bugs": {
    "url": "https://github.com/sonofmagic/uni-app-tailwindcss-template/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/run-template.mjs @default dev",
    "dev:h5": "node scripts/run-template.mjs @default dev:h5",
    "dev:mp-weixin": "node scripts/run-template.mjs @default dev:mp-weixin",
    "build": "pnpm create:build && node scripts/run-template.mjs @default build",
    "build:h5": "node scripts/run-template.mjs @default build:h5 && node scripts/sync-h5-output.mjs",
    "build:app": "node scripts/run-template.mjs @default build:app",
    "build:mp-alipay": "node scripts/run-template.mjs @default build:mp-alipay",
    "build:mp-toutiao": "node scripts/run-template.mjs @default build:mp-toutiao",
    "build:mp-weixin": "node scripts/run-template.mjs @default build:mp-weixin",
    "lint": "node scripts/run-template.mjs @default lint",
    "lint:fix": "node scripts/run-template.mjs @default lint:fix",
    "update:deps": "node scripts/run-template.mjs @default update:deps",
    "update:uni-app": "node scripts/run-template.mjs @default update:uni-app",
    "template": "node scripts/run-template.mjs",
    "templates:matrix": "node scripts/ci-matrix.mjs",
    "test:hmr": "node scripts/run-template.mjs @default test:hmr",
    "test:hmr:artifact:mp-weixin": "node scripts/run-template.mjs @default test:hmr:artifact:mp-weixin",
    "test:hmr:h5": "node scripts/run-template.mjs @default test:hmr:h5",
    "test:hmr:mp-weixin": "node scripts/run-template.mjs @default test:hmr:mp-weixin",
    "test:hmr:app:android": "node scripts/run-template.mjs @default test:hmr:app:android",
    "test:hmr:app:ios": "node scripts/run-template.mjs @default test:hmr:app:ios",
    "test:hmr:all": "node scripts/run-template.mjs @default test:hmr:all",
    "test:app-css": "node scripts/run-template.mjs @default test:app-css",
    "create": "pnpm --dir packages/create-uni-app-tailwindcss start",
    "create:build": "pnpm --dir packages/create-uni-app-tailwindcss build",
    "test": "pnpm test:e2e",
    "test:e2e": "pnpm --dir packages/create-uni-app-tailwindcss test:e2e",
    "test:smoke": "pnpm lint && pnpm test:hmr:artifact:mp-weixin && pnpm test:app-css",
    "release": "pnpm change",
    "release:status": "pnpm change status",
    "version-packages": "pnpm version -r",
    "publish-packages": "repo release stable publish",
    "repo:doctor": "repo doctor"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "repoctl": "5.1.1",
    "vitest": "4.1.10"
  }
}
